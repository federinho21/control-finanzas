{
  "name": "rag-agent-planner",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "build:cf": "set DEPLOY_TARGET=cloudflare&& nuxt build",
    "deploy": "npm run build:cf && wrangler deploy",
    "d1:create": "wrangler d1 create control-finanzas-db",
    "d1:migrate": "wrangler d1 migrations apply control-finanzas-db --remote",
    "d1:migrate:local": "wrangler d1 migrations apply control-finanzas-db --local"
  },
  "dependencies": {
    "@cloudflare/d1": "^1.4.1",
    "@langchain/community": "^1.1.27",
    "@langchain/core": "^1.1.41",
    "@langchain/google-genai": "^2.1.28",
    "@langchain/langgraph": "^1.2.9",
    "@langchain/textsplitters": "^1.0.1",
    "@nuxt/fonts": "^0.11.4",
    "@nuxt/ui": "^4.7.0",
    "@tailwindcss/vite": "^4.2.4",
    "@types/markdown-it": "^14.1.2",
    "better-sqlite3": "^12.9.0",
    "chart.js": "^4.5.1",
    "date-fns": "^4.1.0",
    "drizzle-orm": "^0.45.2",
    "markdown-it": "^14.1.1",
    "nanoid": "^5.1.9",
    "nuxt": "^4.5.2",
    "pdf-parse": "^1.1.4",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "sqlite-vec": "^0.1.9",
    "vue": "^3.5.32",
    "vue-chartjs": "^5.3.3",
    "vue-router": "^5.0.4",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@iconify-json/lucide": "^1.2.105",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25.6.0",
    "@types/pdf-parse": "^1.1.5",
    "@types/pino": "^7.0.5",
    "drizzle-kit": "^0.31.10"
  }
}
