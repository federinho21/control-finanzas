{
  "name": "rag-agent-planner",
  "type": "module",
  "private": true,
  "scripts": {
    "test:ci": "tsx --test tests/ci-policy.test.ts",
    "build:netlify": "nuxt build --preset netlify",
    "build:test": "nuxt build --preset node-server --dotenv tests/fixtures/build.env",
    "test:netlify": "tsx --tsconfig tests/tsconfig.finance.json --test tests/netlify-compat.test.ts",
    "test:chat:behavior": "tsx --tsconfig tests/tsconfig.finance.json --test tests/chat-behavior.test.ts",
    "test:netlify:build": "tsx tests/netlify-build.smoke.ts",
    "test:security:dependencies": "tsx --test tests/dependency-security.test.ts",
    "migrate:firestore": "tsx scripts/migrate-firestore.ts",
    "cleanup:documents": "tsx scripts/cleanup-documents.ts",
    "test:migration": "tsx --test tests/migration.test.ts",
    "test:finance:model": "tsx --test tests/finance-model.test.ts",
    "test:finance": "tsx --tsconfig tests/tsconfig.finance.json --test tests/finance.integration.test.ts tests/finance-only.integration.test.ts",
    "test:backup": "tsx --tsconfig tests/tsconfig.finance.json --test tests/backup-restore.integration.test.ts",
    "typecheck:finance": "tsc --project tests/tsconfig.finance.json",
    "test:auth": "tsx --test tests/auth.test.ts",
    "test:auth:web": "tsx --test tests/web-session.test.ts",
    "typecheck:auth:web": "vue-tsc --project tests/tsconfig.web.json",
    "test:auth:browser": "playwright test --config tests/playwright.config.ts",
    "typecheck:auth": "tsc --project tests/tsconfig.auth.json",
    "test:auth:build": "tsx tests/auth-build.smoke.ts",
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "build:cf": "set DEPLOY_TARGET=cloudflare&& nuxt build",
    "deploy": "npm run build:cf && wrangler deploy",
    "d1:create": "wrangler d1 create control-finanzas-db",
    "d1:migrate": "wrangler d1 migrations apply control-finanzas-db --remote",
    "d1:migrate:local": "wrangler d1 migrations apply control-finanzas-db --local"
  },
  "dependencies": {
    "@cloudflare/d1": "^1.4.1",
    "@langchain/core": "^1.1.49",
    "@langchain/google-genai": "^2.1.28",
    "@langchain/langgraph": "^1.5.1",
    "@langchain/textsplitters": "^1.0.1",
    "@nuxt/fonts": "^0.11.4",
    "@nuxt/ui": "^4.12.0",
    "@tailwindcss/vite": "^4.2.4",
    "@types/markdown-it": "^14.1.2",
    "better-sqlite3": "^12.9.0",
    "chart.js": "^4.5.1",
    "date-fns": "^4.1.0",
    "drizzle-orm": "^0.45.2",
    "firebase": "^13.0.0",
    "firebase-admin": "^14.5.0",
    "markdown-it": "^14.3.3",
    "nanoid": "^5.1.9",
    "nuxt": "^4.5.2",
    "pdf-parse": "^1.1.4",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "sqlite-vec": "^0.1.9",
    "vue": "^3.5.42",
    "vue-chartjs": "^5.3.3",
    "vue-router": "^5.0.4",
    "zod": "^4.3.6"
  },
  "overrides": {
    "esbuild": "0.28.2",
    "@firebase/firestore": {
      "@grpc/grpc-js": "1.14.6"
    }
  },
  "devDependencies": {
    "@iconify-json/lucide": "^1.2.105",
    "@playwright/test": "^1.64.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25.6.0",
    "@types/pdf-parse": "^1.1.5",
    "@types/pino": "^7.0.5",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vue-tsc": "^3.3.13",
    "yaml": "^2.9.0"
  }
}
